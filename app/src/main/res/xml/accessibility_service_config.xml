<?xml version="1.0" encoding="utf-8"?>
<!--
  无障碍服务配置。
  - canPerformGestures：允许 dispatchGesture 派发点击/长按/滑动手势
  - canRetrieveWindowContent：普通录制模式下读取节点 bounds 定位点击坐标
  - notificationTimeout：事件节流
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewClicked|typeViewLongClicked|typeViewScrolled|typeWindowContentChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_desc"
    android:notificationTimeout="50" />
